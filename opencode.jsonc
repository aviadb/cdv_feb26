{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": "ask",
    "bash": {
      "*": "allow",
      "sed -i*": "ask",
      "sed -i''*": "ask",
      "tee *": "ask",
      "tee": "ask",
      "cp *": "ask",
      "mv *": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "mkdir *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "touch *": "ask",
      "truncate *": "ask",
      "dd *": "ask",
      "patch *": "ask",
      "tar *": "ask",
      "zip *": "ask",
      "unzip *": "ask",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git checkout *": "ask",
      "git merge *": "ask",
      "git reset *": "ask",
      "git rebase *": "ask",
      "git clean *": "ask",
      "git stash pop*": "ask",
      "git stash apply*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "npm install*": "ask",
      "npm update*": "ask",
      "npm uninstall*": "ask",
      "npm publish*": "ask",
      "npx *": "ask",
      "yarn add*": "ask",
      "yarn remove*": "ask",
      "yarn install*": "ask",
      "pnpm add*": "ask",
      "pnpm remove*": "ask",
      "pnpm install*": "ask",
      "pip install*": "ask",
      "pip uninstall*": "ask",
      "gem install*": "ask",
      "gem uninstall*": "ask",
      "cargo install*": "ask",
      "cargo uninstall*": "ask"
    }
  }
}
